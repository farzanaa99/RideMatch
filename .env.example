# Database Configuration
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/ridematch

# For SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./ridematch.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# SQL Echo (log all SQL queries)
SQL_ECHO=False
